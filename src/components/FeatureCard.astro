---
import type { Project } from '../data/projects';
import { TECH } from '../data/tech';
import TechIcon from './TechIcon.astro';
import RbacDiagram from './RbacDiagram.astro';

interface Props {
  project: Project;
  /** big: lead card with role + diagram. wide: full-row card, text left and numbers right. */
  variant?: 'big' | 'wide' | 'normal';
}
const { project: p, variant = 'normal' } = Astro.props;
const f = p.featured!;
const big = variant === 'big';
// A card is a link only when there is somewhere to go (case-study pages come later).
const Tag = p.href ? 'a' : 'article';
const linkAttrs = p.href ? { href: p.href, target: '_blank', rel: 'noopener' } : {};
---

<Tag class:list={['card', variant]} {...linkAttrs}>
  <div class="grp main">
    <div class="meta">
      <span class="eyebrow">{f.period}</span>
      <span class="eyebrow">· {p.context}</span>
      {big && <span class="eyebrow">· {p.role}</span>}
    </div>
    <h3>{f.title}</h3>
    <p>{f.description}</p>
    {f.diagram === 'rbac' && <RbacDiagram />}
  </div>
  <div class="grp side">
    <div class="metrics">
      {f.metrics.map((m) => <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}
    </div>
    <div class="card-foot">
      <div class="tags">
        {p.tech.map((k) => <span class="tag chip"><TechIcon name={k} size={12} decorative />{TECH[k].title}</span>)}
      </div>
      {p.href && <span class="read">{f.linkLabel ?? 'Visit ↗'}</span>}
    </div>
  </div>
</Tag>

<style>
  .card {
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 24px;
    display: flex; flex-direction: column; gap: 14px; transition: border-color .15s, transform .15s;
  }
  a.card:hover { border-color: var(--line-strong); transform: translateY(-1px); }
  /* Groups only matter for the wide layout; elsewhere their children join the card's flex column. */
  .grp { display: contents; }

  .meta { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  h3 { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -.01em; line-height: 1.25; }
  .big h3 { font-size: 26px; }
  p { margin: 0; color: var(--muted); font-size: 14.5px; }
  .metrics {
    display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 14px;
    border-top: 1px solid var(--line); padding-top: 14px; margin-top: auto;
  }
  .big .metrics, .wide .metrics { grid-template-columns: repeat(3, 1fr); }
  .metric b { display: block; font: 500 22px/1.1 var(--mono); letter-spacing: -.02em; }
  .metric span { font-size: 12px; color: var(--muted); }
  /* The lead card is as tall as the two stacked ones; let the diagram take up the slack. */
  .big :global(.arch) { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip { display: inline-flex; align-items: center; gap: 5px; }
  .read { font-size: 13px; color: var(--accent); white-space: nowrap; }

  .wide { display: grid; grid-template-columns: 7fr 5fr; gap: 40px; }
  .wide .grp { display: flex; flex-direction: column; gap: 14px; }
  .wide .side { justify-content: flex-end; }

  @media (max-width: 980px) {
    .wide { grid-template-columns: 1fr; gap: 18px; }
  }
  @media (max-width: 640px) {
    .big .metrics, .wide .metrics { grid-template-columns: repeat(2, 1fr); row-gap: 12px; }
    .card-foot { flex-direction: column; align-items: flex-start; }
  }
</style>
