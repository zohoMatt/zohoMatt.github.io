---
import { education } from '../data/experience';
---

<section id="education">
  <div class="edu-block">
    <h2>Education</h2>
    <ul class="list">
      {education.map((e) => (
        <li>
          <a class="entry" href={e.href} target="_blank" rel="noopener">
            <span class="emblem"><img src={e.emblem} alt="" width="44" height="44" loading="lazy" /></span>
            <span class="body">
              <span class="degree">{e.degree}</span>
              <span class="school">{e.school}<span class="ext" aria-hidden="true"> ↗</span> · {e.place}</span>
            </span>
            <span class="years">{e.start} – {e.end}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .edu-block { display: grid; grid-template-columns: 5fr 7fr; gap: 18px; }
  .list { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  .entry { display: flex; gap: 16px; align-items: center; padding: 14px 0; }
  /* The emblem is purple on transparent; a light disc keeps it legible in dark mode. */
  .emblem {
    flex: none; width: 52px; height: 52px; border-radius: 50%; background: #fbf9f4;
    display: grid; place-items: center; box-shadow: 0 0 0 1px var(--line-strong);
  }
  .emblem img { width: 44px; height: 44px; display: block; }
  .body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .degree { font-weight: 500; }
  .school { font-size: 13.5px; color: var(--muted); }
  .ext { color: var(--faint); font-size: 12px; }
  .entry:hover .degree, .entry:hover .ext { color: var(--accent); }
  .years { font: 12px var(--mono); color: var(--faint); white-space: nowrap; }
  @media (max-width: 980px) {
    .edu-block { grid-template-columns: 1fr; }
  }
</style>
